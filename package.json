{
  "name": "dashintel-ai",
  "version": "1.0.0",
  "private": true,
  "description": "DashIntel AI — premium delivery intelligence & profit optimization command center.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "setup": "npm run db:migrate",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "nanoid": "5.1.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "27.4.0",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.5"
  }
}
